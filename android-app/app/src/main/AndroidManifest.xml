<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nzpteam.nzportable"
    android:versionCode="236"
    android:versionName="2.3.6"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <!-- VR (Quest): head tracking disponible pero no obligatorio (los moviles
         no lo tienen y deben poder instalar la app). -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <!-- VR (Quest): hand tracking opcional. Declararlo evita el dialogo
         obligatorio de "coge los mandos" de vrshell (LaunchCheckControllerRequired). -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- NZ:P Android (zurdo): multijugador LAN (broadcast y sockets UDP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- NZ:P Android (zurdo): carpeta de usermaps en /sdcard/NZP/usermaps.
         Nota: /sdcard/Android/data/com.nzpteam.nzportable/files/usermaps
         funciona en todas las versiones de Android y Quest sin permisos extra. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true" >

        <!-- VR (Quest): marca la app como VR. vr_only = Quest la lanza SIEMPRE
             en modo VR (necesario para xrCreateSession; como panel 2D el
             runtime la rechaza con -50). En moviles este meta-data se ignora
             y el juego sigue funcionando normal. -->
        <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />

        <!-- VR (Quest): dispositivos soportados. Sin esto, vrshell muestra el
             dialogo "coge tus mandos" (LaunchCheckControllerRequired) antes de
             lanzar y la app nunca arranca sola. Declararlo deja arrancar la
             sesion OpenXR directamente (mandos o hand tracking). -->
        <meta-data android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|questpro|eureka" />

        <activity android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- VR (Quest): permite lanzarla desde la libreria VR -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
